<http://id.who.int/icd/foundation-plus-experiment> a owl:Ontology ;
    rdfs:label "Foundation-Plus Experiment"@en ;
    rdfs:comment "Experimental ontology combining the WHO-FIC Foundation Component with Mondo Disease Ontology. Includes synonym enrichment (2026-Q3-syn-infectious-01), axis alignments (2026-Q2-axis-align-01), logical definitions (2026-Q3-logdef-infectious-01), extension code proposals (2026-Q3-extcode-infectious-01), and subtree imports (2026-Q3-subtree-infectious-01). Imports mondo.owl and whofic-2025-05-24-labeled.owl."@en ;
    owl:imports obo:mondo.owl,
        <http://who.int/icd> ;
    owl:versionInfo "0.2.0-experiment" .

