# Equivalence Axioms (anchoring new entities to Mondo classes)
# ═══════════════════════════════════════════════════════════

# These allow the ELK reasoner to verify that the new Foundation class
# is logically equivalent to its Mondo source, given the axis alignments
# established in batch 2026-Q2-axis-align-01.

# MONDO_0000225: ehrlichiosis AND hasAgent Ehrlichia chaffeensis (NCBITaxon:945)
EquivalentClasses(
  Annotation(prov:wasDerivedFrom <http://purl.obolibrary.org/obo/MONDO_0000225>)
  Annotation(icd:batchId "2026-Q3-subtree-infectious-01")
  icd-stage:ST-0006
  ObjectIntersectionOf(
    <http://id.who.int/icd/entity/1116297863>
    ObjectSomeValuesFrom(icd:infectiousAgent <http://purl.obolibrary.org/obo/NCBITaxon_945>)
  )
)

